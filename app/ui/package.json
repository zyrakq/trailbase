{
  "name": "velora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "watch": "bun run build --watch",
    "build": "bun pre-build && bunx --bun vite build",
    "pre-build": "bun i18n:build && tsc",
    "i18n:extract": "lit-localize extract",
    "i18n:build": "lit-localize build",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path'),src=path.join('node_modules','@lit','reactive-element','src');fs.mkdirSync(src,{recursive:true});['css-tag','reactive-controller'].forEach(f=>{const dev=path.join('node_modules','@lit','reactive-element','development',f+'.d.ts'),dst=path.join(src,f+'.d.ts');if(fs.existsSync(dev)&&!fs.existsSync(dst))fs.copyFileSync(dev,dst);})\""
  },
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit/localize": "^0.12.2",
    "@lit/localize-tools": "^0.8.1",
    "@lit/reactive-element": "^2.1.2",
    "lit": "^3.3.3",
    "trailbase": "0.12.1",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^15.11.7",
    "prettier": "^3.8.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^2.1.9"
  }
}