    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'post-commander'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=post-commander",
                    "--package=post-commander"
                ],
                "filter": {
                    "name": "post-commander",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "SITE": "https://post-filter.argiago.test",
                "ISSUER": "https://keycloak.argiago.test/realms/argiago-test",

                "DB_URL": "mongodb://root:root@192.168.49.2:32017",
                "DB_NAME": "post_event_store",
                "COLLECTION_NAME": "post",
                "AMQP_ADDR": "amqp://guest:guest@192.168.49.2:32672",
            }
        }
    ]
}